<Window x:Class="Expenses.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="layout" Background="#07101E">
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="ToggleFullScreenInvoked"/>
  </Grid.KeyboardAccelerators>
  <Grid.Resources>
   <DataTemplate x:Key="DialogMetadata"><ContentDialog/></DataTemplate>
   <AcrylicBrush x:Key="LedgerSurfaceBrush" TintColor="#1A314D" TintOpacity="0.40" TintLuminosityOpacity="0.10" FallbackColor="#1A314D"/>
   <AcrylicBrush x:Key="LedgerPaneBrush" TintColor="#1A314D" TintOpacity="0.40" TintLuminosityOpacity="0.10" FallbackColor="#1A314D"/>
   <LinearGradientBrush x:Key="LedgerCardBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1E5DCDE7" Offset="0"/><GradientStop Color="#381A314D" Offset="0.45"/><GradientStop Color="#16978BDB" Offset="1"/>
   </LinearGradientBrush>
   <LinearGradientBrush x:Key="LedgerReflectionBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#165DCDE7" Offset="0"/><GradientStop Color="#005DCDE7" Offset="0.42"/><GradientStop Color="#0C978BDB" Offset="1"/>
   </LinearGradientBrush>
   <LinearGradientBrush x:Key="LedgerPaneReflectionBrush" StartPoint="0,0" EndPoint="0.45,1">
    <GradientStop Color="#165DCDE7" Offset="0"/><GradientStop Color="#005DCDE7" Offset="0.42"/><GradientStop Color="#0C978BDB" Offset="1"/>
   </LinearGradientBrush>
   <SolidColorBrush x:Key="LedgerPaneTextBrush" Color="#E4EEF7"/>
   <SolidColorBrush x:Key="LedgerPaneSecondaryBrush" Color="#B7C9DD"/>
   <SolidColorBrush x:Key="LedgerPaneControlBrush" Color="#AA1A314D"/>
   <SolidColorBrush x:Key="LedgerPaneHoverBrush" Color="#245DCDE7"/>
   <SolidColorBrush x:Key="LedgerPaneAccentBrush" Color="#70D5E8"/>
   <SolidColorBrush x:Key="LedgerNoticeBackgroundBrush" Color="#1A314D"/>
   <SolidColorBrush x:Key="LedgerTextBrush" Color="#E4EEF7"/>
   <SolidColorBrush x:Key="LedgerSecondaryTextBrush" Color="#B7C9DD"/>
   <SolidColorBrush x:Key="LedgerControlBrush" Color="#AA1A314D"/>
   <SolidColorBrush x:Key="LedgerControlHoverBrush" Color="#245DCDE7"/>
   <SolidColorBrush x:Key="LedgerControlPressedBrush" Color="#E61A314D"/>
   <SolidColorBrush x:Key="LedgerSelectionBrush" Color="#285DCDE7"/>
   <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
   <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="FontWeight" Value="Medium"/></Style>
   <SolidColorBrush x:Key="LedgerEdgeBrush" Color="#465DCDE7"/>
   <SolidColorBrush x:Key="LedgerCanvasBrush" Color="#E5ECF1"/>
   <SolidColorBrush x:Key="LedgerAccentBrush" Color="#3F607A"/>
   <Style x:Key="SettingsInfoButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource LedgerSecondaryTextBrush}"/>
   </Style>
   <Style x:Key="SettingsHelpPresenter" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
    <Setter Property="Background" Value="{StaticResource LedgerSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LedgerEdgeBrush}"/>
    <Setter Property="Padding" Value="20"/><Setter Property="MaxWidth" Value="380"/>
   </Style>
   <Style x:Key="NativeCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource LedgerSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LedgerEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/>
   </Style>
   <!-- Shared page language copied from the Web client: header bar, eyebrow + bold title,
        bold card headings, metric tiles and pills. Colours come from the appearance palette. -->
   <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
   <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
   <LinearGradientBrush x:Key="LedgerHeaderBrush" StartPoint="0,0" EndPoint="1,0.35">
    <GradientStop Color="#E05B4350" Offset="0"/><GradientStop Color="#DB364D69" Offset="0.54"/><GradientStop Color="#E61D2E45" Offset="1"/>
   </LinearGradientBrush>
   <SolidColorBrush x:Key="LedgerAccentSoftBrush" Color="#24EDBDA2"/>
   <Style x:Key="PageHeader" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource LedgerHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LedgerEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24,12"/>
    <Setter Property="MinHeight" Value="64"/>
   </Style>
   <Style x:Key="PageEyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerSecondaryTextBrush}"/>
   </Style>
   <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerTextBrush}"/><Setter Property="TextWrapping" Value="NoWrap"/>
   </Style>
   <Style x:Key="CardEyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerSecondaryTextBrush}"/>
   </Style>
   <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="MetricLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerSecondaryTextBrush}"/>
   </Style>
   <Style x:Key="MetricValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <Style x:Key="MetricCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource LedgerSecondaryTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="TableHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LedgerTextBrush}"/>
   </Style>
   <Style x:Key="PillBorder" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="PillText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/>
   </Style>
   <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontWeight" Value="Medium"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,5"/>
    <Setter Property="BorderBrush" Value="{StaticResource LedgerEdgeBrush}"/>
   </Style>
  </Grid.Resources>
  <Border Background="{StaticResource LedgerCanvasBrush}" IsHitTestVisible="False"/>
  <Image x:Name="wallpaperImage" Stretch="UniformToFill" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
  <Border x:Name="wallpaperWash" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
  <Grid x:Name="starfieldLayer" IsHitTestVisible="False">
  <Border x:Name="starfieldBackground" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#07101E" Offset="0"/><GradientStop Color="#102642" Offset="0.52"/><GradientStop Color="#080F23" Offset="1"/>
   </LinearGradientBrush></Border.Background>
  </Border>
  <Canvas x:Name="ambientParticles" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
  </Grid>
  <NavigationView x:Name="navigation" RequestedTheme="Dark" Background="Transparent" PaneTitle="账本" Foreground="{StaticResource LedgerPaneTextBrush}" FontWeight="Medium" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
    PaneDisplayMode="LeftCompact" OpenPaneLength="208" CompactPaneLength="88" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="600"
    AlwaysShowHeader="False" IsPaneOpen="False">
   <NavigationView.Resources>
    <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="LedgerPaneTextBrush"/>
    <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="LedgerPaneSecondaryBrush"/>
    <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="LedgerPaneTextBrush"/>
    <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="LedgerPaneTextBrush"/>
    <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="LedgerPaneTextBrush"/>
    <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="LedgerCardBrush"/>
    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="LedgerPaneHoverBrush"/>
    <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="LedgerPaneControlBrush"/>
    <StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="LedgerEdgeBrush"/>
    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="LedgerPaneAccentBrush"/>
    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="LedgerPaneBrush"/>
    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="LedgerPaneBrush"/>
    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="LedgerPaneBrush"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
   </NavigationView.Resources>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="总览" Tag="overview" Icon="Home"/>
    <NavigationViewItem Content="订单" Tag="orders" Icon="Document"/>
    <NavigationViewItem Content="现金" Tag="cash" Icon="Shop"/>
    <NavigationViewItem Content="付款" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="updateNavigation" Content="更新" Tag="operations" Icon="Sync"/>
    <NavigationViewItem Content="分析" Tag="analysis"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="维护中心" Tag="native-maintenance" Icon="Repair"/>
    <NavigationViewItem Content="桌面设置" Tag="native-settings" Icon="Setting"/>
   </NavigationView.FooterMenuItems>
   <Grid x:Name="nativeContent">
    <Grid.Resources>
     <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="LedgerTextBrush"/>
     <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="LedgerSecondaryTextBrush"/>
     <StaticResource x:Key="ControlFillColorDefaultBrush" ResourceKey="LedgerControlBrush"/>
     <StaticResource x:Key="ButtonBackground" ResourceKey="LedgerControlBrush"/>
     <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="LedgerControlHoverBrush"/>
     <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="LedgerControlPressedBrush"/>
     <StaticResource x:Key="ComboBoxBackground" ResourceKey="LedgerControlBrush"/>
     <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="LedgerControlHoverBrush"/>
     <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="LedgerControlPressedBrush"/>
     <StaticResource x:Key="TextControlBackground" ResourceKey="LedgerControlBrush"/>
     <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="LedgerControlHoverBrush"/>
     <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="LedgerControlHoverBrush"/>
     <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="LedgerSelectionBrush"/>
     <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="LedgerSelectionBrush"/>
    </Grid.Resources>
    <Border x:Name="nativePageSurface" Background="{StaticResource LedgerSurfaceBrush}" BorderBrush="{StaticResource LedgerEdgeBrush}" BorderThickness="1" CornerRadius="20" Margin="12" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Border x:Name="nativePageReflection" Background="{StaticResource LedgerReflectionBrush}" BorderBrush="{StaticResource LedgerEdgeBrush}" BorderThickness="1,1,0,0" CornerRadius="20" Margin="12" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
    <WebView2 x:Name="browser" DefaultBackgroundColor="#07101E" Visibility="Collapsed"/>
    <Border Style="{StaticResource NativeCard}" Visibility="{Binding Visibility, ElementName=webErrorPanel}" Margin="40" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel x:Name="webErrorPanel" Visibility="Collapsed" Spacing="16">
     <TextBlock x:Name="webErrorTitle" Foreground="{StaticResource LedgerTextBrush}" Text="网页暂时不可用" FontSize="26" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
     <TextBlock x:Name="webErrorMessage" Foreground="{StaticResource LedgerTextBrush}" TextWrapping="Wrap"/>
     <Button x:Name="webRetry" Content="重新加载网页" MinHeight="44"/>
     <Button x:Name="webOpenOrders" Content="查看原生订单" MinHeight="44"/>
    </StackPanel></Border>
    <Grid x:Name="financePanel" Visibility="Collapsed" Margin="24" RowSpacing="20">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource PageHeader}">
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="financeEyebrow" Text="资金来源" Style="{StaticResource PageEyebrow}"/>
        <TextBlock x:Name="financeTitle" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
       </StackPanel>
       <Button x:Name="financeRefresh" Grid.Column="1" Content="刷新" Style="{StaticResource HeaderButton}" VerticalAlignment="Center"/>
       <ComboBox x:Name="financeMonth" Grid.Column="2" MinWidth="170" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="月份" PlaceholderText="月份"/>
      </Grid>
     </Border>
     <InfoBar x:Name="financeNotice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
     <Grid x:Name="financeMetrics" Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource NativeCard}" Padding="22,18"><StackPanel Spacing="6">
       <TextBlock x:Name="financeSummaryLabel" Text="本期支出" Style="{StaticResource MetricLabel}"/>
       <TextBlock x:Name="financeSummary" Style="{StaticResource MetricValue}" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="financeDescription" Style="{StaticResource MetricCaption}"/>
      </StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource NativeCard}" Padding="22,18"><StackPanel Spacing="6">
       <TextBlock x:Name="financeMetricTwoLabel" Text="订单" Style="{StaticResource MetricLabel}"/>
       <TextBlock x:Name="financeMetricTwoValue" Text="—" Style="{StaticResource MetricValue}"/>
       <TextBlock x:Name="financeMetricTwoCaption" Style="{StaticResource MetricCaption}"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource NativeCard}" Padding="22,18"><StackPanel Spacing="6">
       <TextBlock x:Name="financeMetricThreeLabel" Text="待处理" Style="{StaticResource MetricLabel}"/>
       <TextBlock x:Name="financeMetricThreeValue" Text="—" Style="{StaticResource MetricValue}"/>
       <TextBlock x:Name="financeMetricThreeCaption" Style="{StaticResource MetricCaption}"/>
      </StackPanel></Border>
     </Grid>
     <Grid Grid.Row="3">
      <ScrollViewer x:Name="sourcesBody" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <Grid x:Name="sourcesColumns" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="sourceCardsBorder" Grid.Row="1" Style="{StaticResource NativeCard}"><StackPanel Spacing="16">
         <StackPanel Spacing="2"><TextBlock Text="付款方式" Style="{StaticResource CardEyebrow}"/><TextBlock Text="本期支出" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/></StackPanel>
         <StackPanel x:Name="sourceCardGroups"/>
        </StackPanel></Border>
        <Border x:Name="sourceCategoriesBorder" Grid.Row="1" Grid.Column="1" Style="{StaticResource NativeCard}"><StackPanel Spacing="16">
         <StackPanel Spacing="2"><TextBlock Text="支出分类" Style="{StaticResource CardEyebrow}"/><TextBlock Text="用途分布" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/></StackPanel>
         <StackPanel x:Name="sourceCategoryGroups" Spacing="16"/>
        </StackPanel></Border>
        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource NativeCard}">
         <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Spacing="2"><TextBlock Text="独立口径" Style="{StaticResource CardEyebrow}"/><TextBlock Text="手填微信付款" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/></StackPanel>
           <Button x:Name="addManualWechat" Grid.Column="1" Content="添加付款" MinHeight="40" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
          </Grid>
          <TextBlock Text="按原币记录，人民币与加币分别显示；不换算，也不并入上方订单支出。" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
          <TextBlock x:Name="manualWechatSummary" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel x:Name="manualWechatRows" Spacing="12"/>
         </StackPanel>
        </Border>
       </Grid>
      </ScrollViewer>
      <Border x:Name="cashBody" Style="{StaticResource NativeCard}" Padding="12,8" Visibility="Collapsed">
       <ListView x:Name="cashList" IsItemClickEnabled="True" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="取现记录，打开可编辑备注" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,14"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate>
         <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LedgerAccentSoftBrush}" VerticalAlignment="Center">
           <FontIcon Glyph="&#xE719;" FontSize="16" Foreground="{StaticResource LedgerAccentBrush}" AutomationProperties.AccessibilityView="Raw"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
           <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Metadata}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
           <TextBlock Text="{Binding NoteSummary}" FontSize="13" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
           <TextBlock Text="{Binding Amount}" FontWeight="Bold" HorizontalAlignment="Right"/>
           <TextBlock Text="编辑备注 ›" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
          </StackPanel>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Border>
      <TextBlock x:Name="financeEmpty" Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,28"/>
      <ProgressRing x:Name="financeLoading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
     <TextBlock x:Name="financeCount" Grid.Row="4" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
    </Grid>
    <Grid x:Name="ordersPanel" Visibility="Collapsed" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <InfoBar x:Name="ordersNotice" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>
     <Grid x:Name="ordersListPanel" Grid.Row="1" RowSpacing="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource PageHeader}">
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="2">
         <TextBlock Text="消费记录" Style="{StaticResource PageEyebrow}"/>
         <TextBlock Text="订单" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        </StackPanel>
        <Button x:Name="ordersRefresh" Grid.Column="1" Content="刷新" Style="{StaticResource HeaderButton}" VerticalAlignment="Center"/>
        <ComboBox x:Name="orderMonth" Grid.Column="2" MinWidth="170" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="月份" PlaceholderText="月份"/>
       </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource NativeCard}" Padding="20,18,20,8">
       <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox x:Name="orderSearch" PlaceholderText="搜索商户、商品或订单号" AutomationProperties.Name="搜索订单" MinHeight="40"/>
         <Button x:Name="orderSearchButton" Grid.Column="1" MinHeight="40" AutomationProperties.Name="搜索" ToolTipService.ToolTip="搜索"><FontIcon Glyph="&#xE721;" FontSize="14"/></Button>
         <Button x:Name="orderClear" Grid.Column="2" Content="重置" MinHeight="40"/>
         <ComboBox x:Name="orderPlatform" Grid.Column="3" PlaceholderText="全部来源" AutomationProperties.Name="来源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="orderCategory" PlaceholderText="全部分类" AutomationProperties.Name="分类" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40"/>
         <ComboBox x:Name="orderCard" Grid.Column="1" PlaceholderText="全部付款" AutomationProperties.Name="付款方式" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40"/>
        </Grid>
        <TextBlock x:Name="ordersCount" Grid.Row="2" Margin="2,6,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
        <Grid Grid.Row="3" Padding="12,8" ColumnSpacing="12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="92"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="14"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="日期" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="1" Text="商户" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="2" Text="分类" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="5" Text="付款" Style="{StaticResource TableHeaderText}"/>
         <TextBlock Grid.Column="6" Text="金额" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="4">
         <ListView x:Name="orderList" SelectionMode="Single" IsItemClickEnabled="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="订单列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="50"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate><DataTemplate>
           <Grid ColumnSpacing="12" Padding="0,12" ToolTipService.ToolTip="{Binding Summary}">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="92"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ShortDate}" VerticalAlignment="Center" FontSize="13"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Style="{StaticResource PillBorder}" Background="{StaticResource LedgerPillWarmBackgroundBrush}"><TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource PillText}" Foreground="{StaticResource LedgerPillWarmForegroundBrush}"/></Border>
            <Border Grid.Column="3" Style="{StaticResource PillBorder}" Background="{StaticResource LedgerPillCoolBackgroundBrush}"><TextBlock Text="{Binding PlatformLabel}" Style="{StaticResource PillText}" Foreground="{StaticResource LedgerPillCoolForegroundBrush}"/></Border>
            <Border Grid.Column="4" Style="{StaticResource PillBorder}" Background="{Binding FulfillmentBackground}"><TextBlock Text="{Binding FulfillmentLabel}" Style="{StaticResource PillText}" Foreground="{Binding FulfillmentForeground}"/></Border>
            <TextBlock Grid.Column="5" Text="{Binding PaymentLabel}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="6" Text="{Binding Amount}" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
            <FontIcon Grid.Column="7" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
           </Grid>
          </DataTemplate></ListView.ItemTemplate>
         </ListView>
         <TextBlock x:Name="ordersEmpty" Text="暂无符合条件的订单" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
         <ProgressRing x:Name="ordersLoading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
       </Grid>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
       <Button x:Name="ordersPrevious" Content="上一页" MinHeight="40" IsEnabled="False"/>
       <Button x:Name="ordersNext" Content="下一页" MinHeight="40" IsEnabled="False"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="orderDetailPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="orderBack" Content="返回订单" MinHeight="40"/><Button x:Name="orderFullRecord" Content="退款与完整记录" MinHeight="40"/></StackPanel>
      <ScrollViewer x:Name="orderDetailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <StackPanel x:Name="orderDetailContent" Spacing="16"/>
      </ScrollViewer>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="settingsPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <StackPanel x:Name="settingsContent" Margin="24" Spacing="20" HorizontalAlignment="Stretch">
      <Border Style="{StaticResource PageHeader}"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="偏好与采集" Style="{StaticResource PageEyebrow}"/><TextBlock Text="桌面设置" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/></StackPanel></Border>
      <InfoBar x:Name="settingsNotice" IsOpen="False" IsClosable="True"/>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="订单采集" Style="{StaticResource CardTitle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
        <Button x:Name="collectorInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="订单采集说明" ToolTipService.ToolTip="订单采集说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="collectorInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="运行位置" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="本地采集使用这台电脑的专用浏览器。VPS 暂停维护，当前无法切换。账本保存在本机。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
       <ComboBox x:Name="collectorLocation" Header="运行位置" MinWidth="240" MinHeight="44" HorizontalAlignment="Left">
        <ComboBoxItem Content="本地运行" Tag="local"/><ComboBoxItem Content="VPS · 暂停维护" Tag="vps" IsEnabled="False"/>
       </ComboBox>
       <TextBlock x:Name="collectorLocationStatus" Text="正在读取…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="collectorLocationRefresh" Content="刷新状态" MinHeight="44"/>
       <Button x:Name="defaultBillPlatforms" Content="默认更新平台" MinHeight="44"/>
       <ToggleSwitch x:Name="parallelCollection" Header="并发采集" OnContent="开启：多个商店同时采集" OffContent="关闭：一个一个采集" IsEnabled="False"/>
       <TextBlock x:Name="parallelCollectionHint" Text="开启后每个商店在专用浏览器的单独窗口里同时采集，导入仍按顺序进行。" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="银行账户" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock x:Name="bankModeStatus" Text="正在读取…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="importBankStatement" Content="导入银行流水文件" MinHeight="44"/>
       <Button x:Name="rerunOnboarding" Content="重新运行首次设置" MinHeight="44"/>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="使用体验" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ToggleSwitch x:Name="completionNotifications" Header="任务提示" OnContent="开启" OffContent="关闭"/>
        <Button x:Name="notificationInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="任务提示说明" ToolTipService.ToolTip="任务提示说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="notificationInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="任务提示" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="采集完成或失败时显示桌面通知。关闭后仍可在维护中心查看结果。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
       <StackPanel Spacing="4">
        <TextBlock Text="语言" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="16" AutomationProperties.Name="语言">
         <RadioButton x:Name="chineseLanguage" GroupName="InterfaceLanguage" Content="中文" MinHeight="44" AutomationProperties.Name="中文"/>
         <RadioButton x:Name="englishLanguage" GroupName="InterfaceLanguage" Content="English" MinHeight="44" AutomationProperties.Name="English"/>
        </StackPanel>
        <TextBlock Text="界面文字会切换为所选语言；账本里的商品名、商户名、分类和备注保持原样。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       </StackPanel>
       <Button x:Name="appearanceSettings" Content="外观" MinHeight="44"/>
       <StackPanel Spacing="4">
        <RadioButtons x:Name="uiScaleChoice" Header="界面大小" MaxColumns="3" AutomationProperties.Name="界面大小">
         <x:String>小</x:String><x:String>中</x:String><x:String>大</x:String>
        </RadioButtons>
        <TextBlock Text="同时作用于所有页面。也可按 Ctrl+加号 / Ctrl+减号切换，Ctrl+0 恢复为中。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       </StackPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="8">
       <TextBlock Text="显示模式" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <RadioButton x:Name="staticVisualMode" GroupName="VisualMode" Content="原版静态" IsChecked="True" MinHeight="44"/>
        <Button x:Name="staticModeInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="原版静态说明" ToolTipService.ToolTip="原版静态说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="staticModeInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="原版静态" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="使用所选壁纸，打开账本时直接进入界面。切换模式后立即生效，并保存到下次启动。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <RadioButton x:Name="particleVisualMode" GroupName="VisualMode" Content="星空粒子" MinHeight="44"/>
        <Button x:Name="particleModeInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="星空粒子说明" ToolTipService.ToolTip="星空粒子说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="particleModeInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="星空粒子" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="启动时星光聚拢成环、旋转后散开，背景支持鼠标避让。原来的静态壁纸会保留。开启减少动效或高对比度后停止动态星点。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ToggleSwitch x:Name="gameMode" Header="游戏模式" OnContent="启用" OffContent="关闭" MinHeight="44" AutomationProperties.Name="游戏模式"/>
        <Button x:Name="gameModeInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="游戏模式说明" ToolTipService.ToolTip="游戏模式说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="gameModeInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="游戏模式" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="在更新页点击流星、飞船与外星人。前往游戏会切到星空背景，静态壁纸仍会保留。关闭游戏只停止互动，不影响账单更新。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
       <Button x:Name="openGame" Content="前往更新" MinHeight="44"/>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="本机账本" Style="{StaticResource CardTitle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
        <Button x:Name="localLedgerInfo" Grid.Column="1" Loaded="SettingsInfoLoaded" Style="{StaticResource SettingsInfoButton}" AutomationProperties.Name="本机账本说明" ToolTipService.ToolTip="本机账本说明">
        <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        <Button.Flyout><Flyout x:Name="localLedgerInfoFlyout" FlyoutPresenterStyle="{StaticResource SettingsHelpPresenter}"><StackPanel Spacing="10" MaxWidth="320">
         <TextBlock Text="本机账本" FontWeight="SemiBold" Foreground="{StaticResource LedgerTextBrush}"/>
         <TextBlock Text="数据保存在这台电脑，采集沿用专用浏览器的登录状态。" TextWrapping="Wrap" Foreground="{StaticResource LedgerTextBrush}"/><TextBlock x:Name="workspaceLocation" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       </Grid>
       <Button x:Name="openBackups" Content="打开备份" MinHeight="44"/>
      </StackPanel></Border>
      <TextBlock x:Name="appVersionText" Text="账本桌面版" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="maintenancePanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <StackPanel x:Name="maintenanceContent" Margin="24" Spacing="20" HorizontalAlignment="Stretch">
      <Border Style="{StaticResource PageHeader}"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="服务与日志" Style="{StaticResource PageEyebrow}"/><TextBlock Text="维护中心" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/></StackPanel></Border>
      <InfoBar x:Name="maintenanceNotice" IsOpen="False" IsClosable="True"/>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="本地服务" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock x:Name="nativeServiceStatus" Text="正在读取状态…" TextWrapping="Wrap"/>
       <TextBlock x:Name="nativeActiveJob" Text="" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <Button x:Name="nativeValidate" Content="校验账本" MinHeight="40"/>
      </StackPanel></Border>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="最近采集" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock x:Name="nativeCollectionSummary" Text="还没有采集记录" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="nativeCollectionTime" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <StackPanel x:Name="nativeCollectionDetails" Spacing="8"/>
       <TextBlock x:Name="nativeCollectionAdvice" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <Button x:Name="nativeOpenUpdates" Content="打开更新账单" MinHeight="40"/>
      </StackPanel></Border>
      <Expander Header="最近任务" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="12">
        <StackPanel x:Name="nativeJobList" Spacing="12"/>
        <Button x:Name="nativeRefresh" Content="刷新状态" MinHeight="40"/>
       </StackPanel>
      </Expander>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="更多排查" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock Text="查看采集详情、统计口径和本地日志。" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <Button x:Name="advancedMaintenance" Content="打开详细维护" MinHeight="40"/>
       <Button x:Name="nativeLogs" Content="打开日志文件夹" MinHeight="40"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="analysisPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <StackPanel x:Name="analysisContent" Margin="24" Spacing="20" HorizontalAlignment="Stretch">
      <Border Style="{StaticResource PageHeader}"><Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="AI 解读" Style="{StaticResource PageEyebrow}"/>
       <TextBlock Text="账本分析" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/></StackPanel>
       <TextBlock x:Name="analysisServiceStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
      </Grid></Border>
      <InfoBar x:Name="analysisNotice" IsOpen="False" IsClosable="True"/>
      <Border Style="{StaticResource NativeCard}"><StackPanel Spacing="14">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleButton x:Name="analysisUseChatGpt" Content="Claude" MinHeight="40" MinWidth="112"/>
        <ToggleButton x:Name="analysisUseDeepSeek" Content="DeepSeek" MinHeight="40" MinWidth="112"/>
       </StackPanel>
       <TextBlock x:Name="analysisProviderHint" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <Grid x:Name="analysisRanges" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="analysisMonth" Tag="month" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="64" Padding="16,10">
         <StackPanel Spacing="2"><TextBlock Text="月度花销" FontWeight="SemiBold"/><TextBlock x:Name="analysisMonthPeriod" Text="本月" Foreground="{StaticResource LedgerSecondaryTextBrush}"/></StackPanel>
        </Button>
        <Button x:Name="analysisYear" Grid.Column="1" Tag="year" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="64" Padding="16,10">
         <StackPanel Spacing="2"><TextBlock Text="年度花销" FontWeight="SemiBold"/><TextBlock x:Name="analysisYearPeriod" Text="最近有记录年份" Foreground="{StaticResource LedgerSecondaryTextBrush}"/></StackPanel>
        </Button>
        <Button x:Name="analysisTrend" Grid.Column="2" Tag="trend" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="64" Padding="16,10">
         <StackPanel Spacing="2"><TextBlock Text="总结与趋势" FontWeight="SemiBold"/><TextBlock x:Name="analysisTrendPeriod" Text="全部账本" Foreground="{StaticResource LedgerSecondaryTextBrush}"/></StackPanel>
        </Button>
       </Grid>
      </StackPanel></Border>
      <Border x:Name="analysisChatGptCard" Style="{StaticResource NativeCard}"><StackPanel Spacing="12">
       <TextBlock Text="用 Claude 分析账本" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock Text="使用 Ledger User 的 Chrome，优先复用已打开的 Claude 页面（沿用 Chrome 里的登录），附件放进草稿后由你发送。月度只含本月，年度取最近有记录的年份，总览由账本持续维护。" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <ProgressBar x:Name="analysisChatGptProgress" IsIndeterminate="True" Visibility="Collapsed"/>
       <TextBlock x:Name="analysisChatGptStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
       <StackPanel x:Name="analysisChatGptPrepared" Spacing="10" Visibility="Collapsed">
        <TextBlock x:Name="analysisChatGptScope" TextWrapping="Wrap"/>
        <TextBlock x:Name="analysisChatGptFile" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button x:Name="analysisRetryAttach" Content="重试附加" MinHeight="40"/>
         <Button x:Name="analysisOpenFile" Content="打开文件" MinHeight="40"/>
         <Button x:Name="analysisCopyPath" Content="复制路径" MinHeight="40"/>
         <Button x:Name="analysisCopyQuestion" Content="复制提问" MinHeight="40"/>
         <Button x:Name="analysisDeleteTemp" Content="删除临时文件" MinHeight="40"/>
        </StackPanel>
       </StackPanel>
      </StackPanel></Border>
      <Border x:Name="analysisDeepSeekCard" Style="{StaticResource NativeCard}" Visibility="Collapsed"><StackPanel Spacing="12">
       <TextBlock x:Name="analysisResultTitle" Text="选择一种分析方式" TextWrapping="Wrap" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock x:Name="analysisResultMeta" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
       <ProgressRing x:Name="analysisResultLoading" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left"/>
       <StackPanel x:Name="analysisResultBody" Spacing="12"/>
      </StackPanel></Border>
      <Border x:Name="analysisChatCard" Style="{StaticResource NativeCard}" Visibility="Collapsed"><StackPanel Spacing="12">
       <TextBlock Text="自由询问" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
       <StackPanel x:Name="analysisChatLog" Spacing="12"/>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="analysisChatInput" PlaceholderText="例如：8月外卖花了多少？" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1200" MinHeight="40" MaxHeight="160" AutomationProperties.Name="自由询问内容"/>
        <Button x:Name="analysisChatSend" Grid.Column="1" Content="发送" MinHeight="40" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"/>
       </Grid>
       <TextBlock Text="省略年份时按今年统计 · Ctrl + Enter 发送 · 相关账本数据会发送到 DeepSeek" TextWrapping="Wrap" Foreground="{StaticResource LedgerSecondaryTextBrush}"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </NavigationView>
  <Border x:Name="loadingCard" Visibility="{Binding Visibility, ElementName=loading}" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="510"><StackPanel x:Name="loading" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
   <TextBlock x:Name="staticLoadingMark" Foreground="{StaticResource LedgerTextBrush}" Text="¥" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
   <Grid x:Name="particleLoadingMark" Width="148" Height="148" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
    <Ellipse x:Name="particleOuterRing" Width="130" Height="130" Stroke="#66CBEAFF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Ellipse Width="92" Height="92" Stroke="#B8E8FAFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Ellipse Width="58" Height="58" Fill="#503F607A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock Text="¥" FontSize="40" FontWeight="SemiBold" Foreground="#F2FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock x:Name="heading" Foreground="{StaticResource LedgerTextBrush}" Text="正在打开账本" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
   <TextBlock x:Name="message" Foreground="{StaticResource LedgerTextBrush}" Text="连接本地账本，马上就好。" TextWrapping="Wrap" HorizontalAlignment="Center"/>
   <ProgressRing x:Name="progress" IsActive="True" Width="32" Height="32"/>
   <Button x:Name="retry" Content="重新连接" Visibility="Collapsed" HorizontalAlignment="Center"/>
   <Button x:Name="logs" Content="查看维护日志" Visibility="Collapsed" HorizontalAlignment="Center"/>
  </StackPanel></Border>

 </Grid>
</Window>
